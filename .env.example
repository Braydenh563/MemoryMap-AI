# Copy this file to `.env` and adjust if needed. `.env` is gitignored.

# Where the SQLite database + preferences file live (created automatically).
MEMORYMAP_DATA_DIR=data

# Where the local Ollama server listens (used from Phase 2 onward).
OLLAMA_URL=http://localhost:11434

# Using LM Studio, llama.cpp, Jan or vLLM instead? Don't set anything here —
# choose the backend in Settings → Models, which saves it with the rest of your
# preferences and applies without a restart. They all speak the same OpenAI
# API, so it is one choice plus an address, not four different setups.
